# PostgreSQL connection
DB_HOST=localhost
DB_NAME=security_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_PORT=5432

# LLM / RAG integration (required for AI-powered threat analysis)
# Supports any OpenAI-compatible API (OpenAI, Azure OpenAI, local Ollama, etc.)
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini

# Optional: enable vulnerable simulation endpoints (for demo only)
ENABLE_VULN_SIMULATION=false

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
